{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "HF_TOKEN": "@hf_token"
  },
  "functions": {
    "api/generate.js": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
